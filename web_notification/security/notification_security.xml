<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Own-records rule: every internal user sees only their own notifications. -->

    <record id="notification_rule_own" model="ir.rule">
        <field name="name">Notification: own records only</field>
        <field name="model_id" ref="model_web_notification" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
