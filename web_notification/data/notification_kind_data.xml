<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Global base kinds (no system_id): usable by any adopting system. -->
    <record id="notification_kind_overdue" model="web.notification.kind">
        <field name="name">Overdue</field>
        <field name="code">overdue</field>
        <field name="sequence">10</field>
    </record>
    <record id="notification_kind_deadline" model="web.notification.kind">
        <field name="name">Due soon</field>
        <field name="code">deadline</field>
        <field name="sequence">20</field>
    </record>
    <record id="notification_kind_assignment" model="web.notification.kind">
        <field name="name">Assigned</field>
        <field name="code">assignment</field>
        <field name="sequence">30</field>
    </record>
</odoo>
