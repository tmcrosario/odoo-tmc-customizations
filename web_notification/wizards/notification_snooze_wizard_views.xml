<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="web_notification_snooze_wizard_view_form" model="ir.ui.view">
        <field name="name">web.notification.snooze.wizard.form</field>
        <field name="model">web.notification.snooze.wizard</field>
        <field name="arch" type="xml">
            <form string="Snooze notification">
                <group>
                    <field name="notification_id" invisible="1" />
                    <field name="snooze_until" options="{'numeric': True}" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Snooze"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
